# For Google Cloud KMS
gcloud iam workload-identity-pools create gh-actions \
  --location=global

# Grant GitHub Actions access
gcloud iam service-accounts add-iam-policy-binding \
  eheps-pki@project.iam.gserviceaccount.com \
  --member="principalSet://iam.googleapis.com/projects/123/locations/global/workloadIdentityPools/gh-actions/attribute.repository/EHEPS-International/eheps-pki" \
  --role="roles/cloudkms.cryptoKeySigner"
